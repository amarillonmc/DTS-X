{
  "name": "dts-x",
  "version": "0.1.0",
  "private": true,
  "description": "电波 DTS Unstable — Node.js / WebAssembly edition",
  "type": "module",
  "engines": { "node": ">=24.18.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "configure": "node scripts/configure.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "compile": "node --env-file-if-exists=.env scripts/compile.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs"
  },
  "dependencies": {
    "@php-wasm/node": "3.1.60",
    "@php-wasm/universal": "3.1.60",
    "ws": "8.21.0"
  }
}
