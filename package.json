{
  "name": "dts-x",
  "version": "0.1.0",
  "private": true,
  "description": "电波 DTS Unstable — native Node.js edition",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "configure": "node scripts/configure.mjs",
    "setup": "node --env-file-if-exists=.env native/setup.mjs",
    "compile": "node --env-file-if-exists=.env native/compile.mjs",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:native": "node --test tests/native-*.test.mjs",
    "native:inventory": "node scripts/native-inventory.mjs",
    "native:status": "node scripts/native-status.mjs",
    "verify:native": "node scripts/native-inventory.mjs --check",
    "verify:source": "node scripts/verify-source.mjs",
    "doctor": "node --env-file-if-exists=.env native/doctor.mjs"
  },
  "dependencies": {
    "fs-ext-extra-prebuilt": "2.2.16",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "php-parser": "3.7.0",
    "@php-wasm/node": "3.1.60",
    "@php-wasm/universal": "3.1.60",
    "ws": "8.21.0"
  }
}
