# Generate actual random credentials with: node scripts/configure.mjs --url=https://dts.example.com
PUBLIC_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dtsx
DB_USER=dtsx
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-random-password
TABLE_PREFIX=dtsx_
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-12-to-24
NATIVE_TICK_MS=1000
# NATIVE_DATA_DIR=var/native
MAX_BODY_MB=64
AUTO_SETUP=1
# For direct HTTP access without a reverse proxy, set BIND_ADDRESS=0.0.0.0.
BIND_ADDRESS=127.0.0.1
# Enable only behind one controlled proxy that replaces X-Forwarded-For.
# Keep disabled for direct access (BIND_ADDRESS=0.0.0.0).
TRUST_PROXY=0
